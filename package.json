{
  "name": "starfront-launcher",
  "version": "1.2.21-alpha",
  "description": "StarFront — Arma 3 Launcher",
  "author": "StarFront",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "node scripts/sync-bot-config.mjs && vite build",
    "start": "electron .",
    "pack": "node scripts/sync-bot-config.mjs && npm run build && electron-builder --win portable",
    "release:zip": "powershell -NoProfile -Command \"Compress-Archive -Force -Path release\\StarFrontLauncher.exe -DestinationPath release\\StarFrontLauncher-$((Get-Content package.json | ConvertFrom-Json).version).zip\"",
    "release:meta": "node scripts/generate-latest-yml.mjs",
    "release:prepare": "npm run pack && npm run release:zip && npm run release:meta",
    "pack:store": "node scripts/make-appx-assets.mjs && npm run build && electron-builder --config electron-builder.store.cjs --win appx --x64",
    "hero:transparent": "node scripts/make-hero-transparent.mjs",
    "icon": "node scripts/make-app-icon.mjs"
  },
  "build": {
    "appId": "com.starfront.launcher",
    "productName": "StarFrontLauncher",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "preset/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "preset", "to": "preset" },
      {
        "from": "bot-manager-python/resources",
        "to": "online-bot",
        "filter": ["a2s.js", "config.json", "commands/**", "online-status-server.js"]
      }
    ],
    "asar": true,
    "compression": "store",
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "StarFrontLauncher-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "StarFrontLauncher.exe"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
